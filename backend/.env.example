# Local development only. These are not production credentials.
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://127.0.0.1:8787
DEV_AUTH=true
DEV_EMAIL=reader@example.test
DEV_PASSWORD=change-this-local-password
# Without DATABASE_URL, embedded PostgreSQL persists in .local/database.
# DATABASE_URL=postgresql://...
# If DATABASE_URL contains [YOUR-PASSWORD], enter the existing password separately:
# DATABASE_PASSWORD=...
# Production requires HTTPS, DEV_AUTH=false, and the following:
# NODE_ENV=production
# OWNER_EMAIL=your-email@example.com
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_KEY=... (server only, used only for storage/account deletion)
# STORAGE_BUCKET=articles
# Optional owner-only reading context (one OpenRouter call per generated note):
# OPENROUTER_API_KEY=...
# READING_CONTEXT_MODEL=google/gemini-3.8-flash
# READING_CONTEXT_DAILY_LIMIT=30
# READING_CONTEXT_BACKGROUND_DAILY_LIMIT=300
